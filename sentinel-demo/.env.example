# Vertex AI Configuration (recommended)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Local dev only: service account key file (Cloud Run uses ADC automatically)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# OR: Direct Gemini API Key (legacy fallback)
# GEMINI_API_KEY=your-api-key-here

# OpenAI (for synthesis via GPT-5.2)
OPENAI_API_KEY=your-openai-key-here

# Claude Opus 4.5 via AWS Bedrock
# Uses standard AWS credential chain
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AI Mode: "mock" uses mock data, "live" calls real APIs
AI_MODE=mock
